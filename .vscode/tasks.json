{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Keil: 构建",
            "type": "process",
            "command": "rtk",
            "args": ["proxy", "powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/keil.ps1", "-Action", "Build"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Keil: 全部重建",
            "type": "process",
            "command": "rtk",
            "args": ["proxy", "powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/keil.ps1", "-Action", "Rebuild"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Keil: 构建并烧录",
            "type": "process",
            "command": "rtk",
            "args": ["proxy", "powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/keil.ps1", "-Action", "Flash"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        }
    ]
}
