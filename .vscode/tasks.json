{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32Cube: 构建 Debug",
            "type": "process",
            "command": "rtk",
            "args": [
                "proxy",
                "powershell.exe",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/stm32cube.ps1",
                "-Action",
                "Build",
                "-Configuration",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
