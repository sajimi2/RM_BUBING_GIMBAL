set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

# 优先使用 STM32Cube 安装的 GCC，防止系统 PATH 中的另一版本抢先匹配。
set(ARM_GCC_BIN "" CACHE PATH "Directory containing arm-none-eabi-gcc")
if(NOT ARM_GCC_BIN AND DEFINED ENV{ARM_GCC_BIN})
    set(ARM_GCC_BIN "$ENV{ARM_GCC_BIN}")
endif()
set(CUBE_BUNDLES "$ENV{CUBE_BUNDLE_PATH}")
if(NOT CUBE_BUNDLES AND CMAKE_HOST_WIN32)
    set(CUBE_BUNDLES "$ENV{LOCALAPPDATA}/stm32cube/bundles")
endif()
if(CUBE_BUNDLES)
    file(GLOB CUBE_GCC_HINTS LIST_DIRECTORIES true "${CUBE_BUNDLES}/gnu-tools-for-stm32/*/bin")
    list(SORT CUBE_GCC_HINTS COMPARE NATURAL ORDER DESCENDING)
endif()
find_program(CMAKE_C_COMPILER arm-none-eabi-gcc HINTS "${ARM_GCC_BIN}" ${CUBE_GCC_HINTS} REQUIRED)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
get_filename_component(ARM_GCC_DIR "${CMAKE_C_COMPILER}" DIRECTORY)
find_program(CMAKE_OBJCOPY arm-none-eabi-objcopy HINTS "${ARM_GCC_DIR}" REQUIRED NO_DEFAULT_PATH)
find_program(CMAKE_SIZE arm-none-eabi-size HINTS "${ARM_GCC_DIR}" REQUIRED NO_DEFAULT_PATH)

set(MCU_FLAGS "-mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard")
set(CMAKE_C_FLAGS_INIT "${MCU_FLAGS}")
set(CMAKE_ASM_FLAGS_INIT "${MCU_FLAGS} -x assembler-with-cpp")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${MCU_FLAGS}")
set(CMAKE_C_FLAGS_DEBUG "-Og -g3" CACHE STRING "Debug flags")
set(CMAKE_C_FLAGS_RELEASE "-O2 -g1 -DNDEBUG" CACHE STRING "Release flags")
