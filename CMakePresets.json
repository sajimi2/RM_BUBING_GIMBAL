{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "Debug",
            "displayName": "STM32F407 GCC Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Debug",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "Release",
            "inherits": "Debug",
            "displayName": "STM32F407 GCC Release",
            "binaryDir": "${sourceDir}/build/Release",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        { "name": "Debug", "configurePreset": "Debug" },
        { "name": "Release", "configurePreset": "Release" },
        { "name": "Flash-Debug", "configurePreset": "Debug", "targets": ["flash"] },
        { "name": "Flash-Release", "configurePreset": "Release", "targets": ["flash"] }
    ]
}
